# Production configuration for cinference-qwen38-4090.service (RTX 4090, Qwen3.8-27B).
# Selected from bench_results_matrix_20260923: K7 is fastest or within 1% of fastest on structured,
# code and reasoning traffic and +60-68% over the previous K3 engine on long-context recall.
# 188416 tokens keeps >1 GiB of device memory free with MTP; 196608 leaves ~0.95 GiB.
CINF_BIN=/home/aramirezfamily/josh/cinference-4090/releases/ada-k10-perf-a1be740/ninfer-serve
CINF_MODEL=/home/aramirezfamily/josh/cinference-4090/models/qwen3_8_27b.v3.ninfer
CINF_HOST=100.119.241.20
CINF_PORT=8080
CINF_MODEL_ID=qwen/qwen3.8-27b
CINF_MAX_CONTEXT=188416
CINF_KV_CAPACITY=188416
CINF_KV_DTYPE=k8v4
CINF_MAX_CONCURRENCY=1
CINF_MAX_PENDING_REQUESTS=16
CINF_PENDING_TIMEOUT_MS=600000
CINF_PREFILL_CHUNK=1024
CINF_SPEC_ARGS=--spec mtp --draft-tokens 7 --lm-head-draft
CINF_DEFAULT_MAX_TOKENS=8192
CINF_REQUEST_LOG=/home/aramirezfamily/josh/cinference-4090/profiles/serve/qwen38-4090.requests.jsonl
