[Unit]
Description=Cinference RTX 4090 Qwen3.8-27B inference server (ada-k10-perf)
After=network-online.target
Wants=network-online.target
Before=litellm.service
Conflicts=ninfer-qwen38-4090.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/josh/cinference-4090
Environment=PATH=%h/.local/bin:/usr/local/cuda-13/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda-13/lib64
EnvironmentFile=%h/.config/cinference/qwen38.env
ExecStartPre=/usr/bin/test -x ${CINF_BIN}
ExecStartPre=/usr/bin/test -r ${CINF_MODEL}
ExecStartPre=/usr/bin/install -d -m 700 %h/josh/cinference-4090/profiles/serve
ExecStart=/bin/sh -c 'exec "$CINF_BIN" "$CINF_MODEL" \
    --host "$CINF_HOST" --port "$CINF_PORT" --model-id "$CINF_MODEL_ID" \
    --max-context "$CINF_MAX_CONTEXT" --kv-capacity "$CINF_KV_CAPACITY" --kv-dtype "$CINF_KV_DTYPE" \
    --max-concurrency "$CINF_MAX_CONCURRENCY" --max-pending-requests "$CINF_MAX_PENDING_REQUESTS" \
    --pending-timeout-ms "$CINF_PENDING_TIMEOUT_MS" --prefill-chunk "$CINF_PREFILL_CHUNK" \
    $CINF_SPEC_ARGS --preserve-thinking --default-max-tokens "$CINF_DEFAULT_MAX_TOKENS" \
    --request-log-jsonl "$CINF_REQUEST_LOG"'
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
UMask=0077
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
