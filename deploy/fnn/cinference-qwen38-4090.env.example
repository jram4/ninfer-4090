# Copy to cinference-qwen38-4090.env (ignored by git) and fill in local paths.
# systemd EnvironmentFile does not expand variables; use absolute paths.
CINF_BIN=/path/to/cinference-4090/releases/<release>/ninfer-serve
CINF_MODEL=/path/to/cinference-4090/models/qwen3_8_27b.v3.ninfer
CINF_HOST=127.0.0.1
CINF_PORT=8080
CINF_MODEL_ID=qwen/qwen3.8-27b
CINF_MAX_CONTEXT=188416
CINF_KV_CAPACITY=188416
CINF_KV_DTYPE=k8v4
CINF_MAX_CONCURRENCY=1
CINF_MAX_PENDING_REQUESTS=16
CINF_PENDING_TIMEOUT_MS=600000
CINF_PREFILL_CHUNK=1024
CINF_SPEC_ARGS=--spec mtp --draft-tokens 7 --lm-head-draft
CINF_DEFAULT_MAX_TOKENS=8192
CINF_REQUEST_LOG=/path/to/cinference-4090/profiles/serve/qwen38-4090.requests.jsonl
